    <script>
    (function () {
        'use strict';

        /* ============================================================
         * CONFIG — derive admin API base from current page location
         * Matches the same discovery pattern used in Helpers.php
         * ============================================================ */
        const PAGE_SLUG = "css2-2";
        const APP_BASE  = "\/";

        // Build admin API base: same host + APP_BASE + /Admin/api
        function buildApiBase() {
            const origin = window.location.origin;
            const base   = APP_BASE === '/' ? '' : APP_BASE;
            return origin + base + '/Admin/api';
        }

        const API_BASE = buildApiBase();

        /* ============================================================
         * HELPERS
         * ============================================================ */
        function formatPrice(val) {
            if (!val || val <= 0) return null;
            return '₹' + Number(val).toLocaleString('en-IN');
        }

        function difficultyBadgeClass(difficulty) {
            if (!difficulty) return '';
            const d = difficulty.toLowerCase();
            if (d === 'easy')      return 'badge-easy';
            if (d === 'difficult') return 'badge-difficult';
            return 'badge-moderate';
        }

        function buildImageSrc(bannerImage) {
            if (!bannerImage) return 'assets/img/home2/banner-img1.jpg';
            // If it's already a full URL or absolute path, use as-is
            if (bannerImage.startsWith('http') || bannerImage.startsWith('/')) return bannerImage;
            // Files uploaded from admin are stored in Admin/Public/uploads/treks/
            return 'Admin/Public/uploads/treks/' + bannerImage;
        }

        /* ============================================================
         * FETCH HELPERS
         * ============================================================ */
        async function apiFetch(path) {
            const url = API_BASE + path;
            const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
        }

        /* ============================================================
         * RENDERERS
         * ============================================================ */

        /**
         * Render hero section with real category data
         */
        function renderHero(cat) {
            // Background image
            const heroBg = document.getElementById('category-hero-bg');
            if (heroBg) {
                heroBg.classList.remove('hero-skeleton');
                if (cat.image) {
                    heroBg.style.backgroundImage =
                        'linear-gradient(rgba(17,24,39,0.4),rgba(17,24,39,0.6)), url("' + buildImageSrc(cat.image) + '")';
                } else {
                    heroBg.style.backgroundImage =
                        "linear-gradient(rgba(17,24,39,0.4),rgba(17,24,39,0.6)), url('assets/img/home2/banner-img1.jpg')";
                }
            }

            // Breadcrumb
            const breadcrumbEl = document.getElementById('hero-breadcrumb');
            if (breadcrumbEl) {
                const homeHref = APP_BASE === '/' ? '/' : APP_BASE;
                if (cat.breadcrumb && cat.breadcrumb.length > 0) {
                    let html = `<a href="${homeHref}">Home</a>`;
                    cat.breadcrumb.forEach((b, i) => {
                        const path = cat.breadcrumb.slice(0, i + 1).map(x => x.slug).join('/');
                        const href = (APP_BASE === '/' ? '' : APP_BASE) + '/' + path;
                        html += ` › <a href="${href}">${b.name}</a>`;
                    });
                    breadcrumbEl.innerHTML = html;
                } else {
                    breadcrumbEl.innerHTML = `<a href="${homeHref}">Home</a> › Treks › ${cat.name}`;
                }
            }

            // Title
            const titleEl = document.getElementById('hero-title');
            if (titleEl) {
                titleEl.textContent = cat.name || 'Treks';
                document.title     = cat.seo_title || (cat.name + ' | Alpha Adventures');
            }

            // Description
            const descEl = document.getElementById('hero-desc');
            if (descEl) {
                descEl.textContent = cat.description || '';
            }

            // SEO section
            if (cat.description) {
                const seoArea = document.getElementById('seo-content-area');
                const seoWrap = document.getElementById('seo-content-wrap');
                if (seoArea && seoWrap) {
                    seoWrap.innerHTML =
                        '<h2>' + (cat.name || 'About This Category') + '</h2>' +
                        '<p>' + cat.description.replace(/\n/g, '</p><p>') + '</p>';
                    seoArea.style.display = '';
                }
            }
        }

        /**
         * Render subcategory chips
         */
        function renderSubcategories(subcategories, currentCat) {
            const container = document.getElementById('subcategory-list');
            if (!container) return;

            // Remove skeleton chips
            container.querySelectorAll('.subcategory-chip-skeleton-wrap').forEach(el => el.remove());

            if (!subcategories || subcategories.length === 0) return;

            // Build hierarchical path prefix from current category's breadcrumb
            let pathPrefix = '';
            if (currentCat && currentCat.breadcrumb && currentCat.breadcrumb.length > 0) {
                pathPrefix = currentCat.breadcrumb.map(b => b.slug).join('/');
            } else {
                pathPrefix = PAGE_SLUG;
            }

            subcategories.forEach(sub => {
                const col = document.createElement('div');
                col.className = 'col-lg-3 col-md-4 col-sm-6';

                // Build pretty hierarchical URL path
                const href = (APP_BASE === '/' ? '' : APP_BASE) + '/' + pathPrefix + '/' + encodeURIComponent(sub.slug);
                col.innerHTML =
                    '<a href="' + href + '" class="subcategory-card">' +
                        '<i class="bi bi-geo-alt"></i>' +
                        '<div>' +
                            '<h6>' + sub.name + '</h6>' +
                            '<span>' + (sub.subcategories ? sub.subcategories.length : '') + '</span>' +
                        '</div>' +
                    '</a>';
                container.appendChild(col);
            });
        }

        /**
         * Render a single trek card HTML string
         */
        function renderTrekCard(trek) {
            const displayPrice   = trek.discount_price > 0 ? trek.discount_price : trek.original_price;
            const originalPrice  = trek.discount_price > 0 ? trek.original_price : null;
            const priceStr       = formatPrice(displayPrice);
            const origPriceStr   = formatPrice(originalPrice);

            const difficulty     = trek.difficulty || '';
            let badgeClass       = difficultyBadgeClass(difficulty);
            let badgeLabel       = difficulty ? difficulty.charAt(0).toUpperCase() + difficulty.slice(1) : '';

            // Override badge if subcategory exists
            if (trek.subcategory && trek.subcategory.name) {
                badgeLabel = trek.subcategory.name;
                // Optional: You could use a neutral class like 'badge-primary' or 'badge-info' 
                // but re-using badgeClass or falling back to 'badge-moderate' for styling
                badgeClass = 'badge-moderate'; // Or any distinct CSS class if preferred
            }

            const duration       = trek.nights + 'N/' + trek.days + 'D';
            const altitude       = trek.highest_altitude ? trek.highest_altitude : null;
            const location       = trek.location || (trek.category ? trek.category.name : '');
            const imgSrc         = buildImageSrc(trek.banner_image);
            const categoryPath   = (trek.category && trek.category.path) ? trek.category.path : 'upcoming-treks';
            const detailUrl      = (APP_BASE === '/' ? '' : APP_BASE) + '/' + categoryPath + '/detail/' + encodeURIComponent(trek.slug);

            return '<div class="trek-card">' +
                '<div class="trek-card-img-wrap">' +
                    (badgeLabel ? '<span class="trek-badge ' + badgeClass + '">' + badgeLabel + '</span>' : '') +
                    '<a href="' + detailUrl + '">' +
                        '<img src="' + imgSrc + '" alt="' + trek.title + '" loading="lazy" ' +
                             'onerror="this.src=\'assets/img/home2/banner-img1.jpg\'">' +
                    '</a>' +
                '</div>' +
                '<div class="trek-card-content">' +
                    '<a href="' + detailUrl + '" class="trek-title">' + trek.title + '</a>' +
                    '<div class="trek-location">' +
                        '<i class="bi bi-geo-alt-fill text-primary"></i> ' + (location || '&mdash;') +
                    '</div>' +
                    '<div class="trek-stats">' +
                        '<span class="trek-stat-item"><i class="bi bi-clock"></i> ' + duration + '</span>' +
                        (badgeLabel ? '<span class="trek-stat-item"><i class="bi bi-activity"></i> ' + badgeLabel + '</span>' : '') +
                        (altitude   ? '<span class="trek-stat-item"><i class="bi bi-triangle"></i> ' + altitude + '</span>' : '') +
                    '</div>' +
                    '<div class="trek-card-footer">' +
                        '<div>' +
                            '<span class="trek-price-label">Starting from</span>' +
                            '<span class="trek-price-value">' +
                                (origPriceStr ? '<span class="trek-price-original">' + origPriceStr + '</span>' : '') +
                                (priceStr || 'Contact Us') +
                            '</span>' +
                        '</div>' +
                        '<a href="' + detailUrl + '" class="btn-view-trek">View Trek</a>' +
                    '</div>' +
                '</div>' +
            '</div>';
        }

        /**
         * Render the treks grid
         */
        function renderTreks(treks) {
            const grid     = document.getElementById('treks-grid');
            const countLbl = document.getElementById('trek-count-label');
            if (!grid) return;

            // Remove skeleton columns
            grid.querySelectorAll('.trek-skeleton-col').forEach(el => el.remove());

            if (!treks || treks.length === 0) {
                grid.innerHTML =
                    '<div class="col-12">' +
                        '<div class="treks-empty-state">' +
                            '<i class="bi bi-compass"></i>' +
                            '<h5>No treks found</h5>' +
                            '<p>Try adjusting your filters or explore another category.</p>' +
                        '</div>' +
                    '</div>';
                if (countLbl) countLbl.textContent = '0 Treks Found';
                return;
            }

            if (countLbl) countLbl.textContent = treks.length + ' Trek' + (treks.length !== 1 ? 's' : '') + ' Found';

            // Clear the grid to remove previous results, empty states, or loaders
            grid.innerHTML = '';

            treks.forEach(trek => {
                const col = document.createElement('div');
                col.className = 'col-lg-4 col-md-6';
                col.innerHTML = renderTrekCard(trek);
                grid.appendChild(col);
            });
        }

        /**
         * Show an error state in the treks grid
         */
        function showTreksError(msg) {
            const grid = document.getElementById('treks-grid');
            if (!grid) return;
            grid.querySelectorAll('.trek-skeleton-col').forEach(el => el.remove());
            grid.innerHTML =
                '<div class="col-12">' +
                    '<div class="treks-empty-state">' +
                        '<i class="bi bi-exclamation-circle"></i>' +
                        '<h5>Could not load treks</h5>' +
                        '<p>' + (msg || 'Please try again later.') + '</p>' +
                    '</div>' +
                '</div>';
        }

        /**
         * Show an error in the hero area
         */
        function showHeroError() {
            const heroBg = document.getElementById('category-hero-bg');
            if (heroBg) {
                heroBg.classList.remove('hero-skeleton');
                heroBg.style.backgroundImage =
                    "linear-gradient(rgba(17,24,39,0.4),rgba(17,24,39,0.6)), url('assets/img/home2/banner-img1.jpg')";
            }
            const titleEl = document.getElementById('hero-title');
            if (titleEl) titleEl.textContent = 'Treks';
            const breadcrumbEl = document.getElementById('hero-breadcrumb');
            if (breadcrumbEl) breadcrumbEl.textContent = 'Home › Treks';
            const descEl = document.getElementById('hero-desc');
            if (descEl) descEl.textContent = '';

            // Clear subcategory skeletons silently
            const container = document.getElementById('subcategory-list');
            if (container) container.querySelectorAll('.subcategory-chip-skeleton-wrap').forEach(el => el.remove());
        }

        /* ============================================================
         * TREK FETCH (with filter + sort params)
         * ============================================================ */
        function buildTreksPath(difficulty, location, duration, sort) {
            let path = '/v1/treks/';
            const qs = [];
            if (PAGE_SLUG)   qs.push('category_slug=' + encodeURIComponent(PAGE_SLUG));
            if (difficulty)  qs.push('difficulty='    + encodeURIComponent(difficulty));
            if (location)    qs.push('location='      + encodeURIComponent(location));
            if (duration)    qs.push('duration='      + encodeURIComponent(duration));
            if (sort && sort !== 'featured') qs.push('sort='  + encodeURIComponent(sort));
            if (qs.length)   path += '?' + qs.join('&');
            return path;
        }

        async function fetchAndRenderTreks(difficulty, location, duration, sort) {
            try {
                const json = await apiFetch(buildTreksPath(difficulty, location, duration, sort));
                const treks = (json.success && Array.isArray(json.data)) ? json.data : [];
                renderTreks(treks);
            } catch (err) {
                console.error('[CategoryTreks] Trek fetch error:', err);
                showTreksError('Failed to load treks. Please refresh the page.');
            }
        }

        /* ============================================================
         * CATEGORY FETCH
         * ============================================================ */
        async function fetchCategory() {
            if (!PAGE_SLUG) {
                showHeroError();
                return;
            }
            try {
                const json = await apiFetch('/v1/treks/categories/' + encodeURIComponent(PAGE_SLUG));
                if (!json.success || !json.data) {
                    showHeroError();
                    return;
                }
                const cat = json.data;
                renderHero(cat);
                renderSubcategories(cat.subcategories || [], cat);
            } catch (err) {
                console.error('[CategoryTreks] Category fetch error:', err);
                showHeroError();
            }
        }

        /* ============================================================
         * FILTER / SORT CONTROLS
         * ============================================================ */
        function bindFilterControls() {
            const difficultySelect = document.getElementById('trekDifficulty');
            const locationSelect   = document.getElementById('trekLocation');
            const durationSelect   = document.getElementById('trekDuration');
            const sortSelect       = document.getElementById('trekSort');
            const resetBtn         = document.getElementById('resetFilters');

            if (!difficultySelect || !locationSelect || !durationSelect || !sortSelect) return;

            function onFilterChange() {
                // Re-remove any remaining trek cards to show loading state again
                const grid = document.getElementById('treks-grid');
                if (grid) {
                    // Clear all previous results, empty states, and errors (leave skeleton cols if still present)
                    Array.from(grid.children).forEach(child => {
                        if (!child.classList.contains('trek-skeleton-col')) {
                            child.remove();
                        }
                    });

                    // Show a minimal loading indicator
                    const loadingRow = document.createElement('div');
                    loadingRow.className = 'col-12 text-center py-5 filter-loading-col';
                    loadingRow.innerHTML = '<div class="spinner-border text-warning" role="status"></div>';
                    grid.appendChild(loadingRow);
                }

                const difficulty = difficultySelect.value;
                const location   = locationSelect.value;
                const duration   = durationSelect.value;
                const sort       = sortSelect.value;

                fetchAndRenderTreks(difficulty, location, duration, sort).then(() => {
                    const loader = document.querySelector('.filter-loading-col');
                    if (loader) loader.remove();
                });
            }

            difficultySelect.addEventListener('change', onFilterChange);
            locationSelect.addEventListener('change', onFilterChange);
            durationSelect.addEventListener('change', onFilterChange);
            sortSelect.addEventListener('change', onFilterChange);

            if (resetBtn) {
                resetBtn.addEventListener('click', function() {
                    difficultySelect.value = '';
                    locationSelect.value   = '';
                    durationSelect.value   = '';
                    sortSelect.value       = 'featured';
                    onFilterChange();
                });
            }
        }

        /* ============================================================
         * INIT — run on DOMContentLoaded
         * ============================================================ */
        document.addEventListener('DOMContentLoaded', function () {
            // Fire both fetches in parallel
            Promise.all([
                fetchCategory(),
                fetchAndRenderTreks('', '', '', 'featured')
            ]).catch(function (e) {
                console.error('[CategoryTreks] Init error:', e);
            });

            bindFilterControls();
        });

    })();
    </script>

