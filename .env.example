# Supabase (public client config — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase service role — SERVER-ONLY. Required for guest booking server actions
# (bypasses RLS). Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email — SERVER-ONLY. Brevo HTTP API is preferred (no SMTP IP
# allowlist; works from serverless). If BREVO_API_KEY is unset, the mailer
# falls back to the SMTP_* creds below.
BREVO_API_KEY=
# Verified sender (must be on a Brevo-authenticated domain) + admin recipient.
# alphaadventures.in has DMARC p=quarantine: authenticate it in Brevo (SPF +
# DKIM DNS records) BEFORE switching to this sender, or mail goes to spam.
EMAIL_FROM="Alpha Adventures <bookings@alphaadventures.in>"
# Where customer replies land (defaults to info@alphaadventures.in).
EMAIL_REPLY_TO=
ADMIN_NOTIFY_EMAIL=

# SMTP fallback (used only when BREVO_API_KEY is unset).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# PhonePe PG V2 Standard Checkout (SERVER-ONLY). If CLIENT_ID/SECRET are unset,
# booking falls back to the mock payment path. Creds come from the PhonePe
# Merchant Dashboard (enable the Test toggle for UAT). PHONEPE_ENV selects the
# hosts: sandbox -> api-preprod.phonepe.com/apis/pg-sandbox; production ->
# api.phonepe.com (token on identity-manager, PG on /apis/pg).
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=sandbox
# Absolute base the gateway redirects the browser back to (no trailing slash).
PHONEPE_REDIRECT_BASE=http://localhost:3000
# Webhook auth: the username+password you set for the callback URL in the
# dashboard. PhonePe sends Authorization = SHA256(username:password) on the
# server-to-server callback; /api/phonepe/callback verifies it.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Cleanup cron (/api/cron/expire-bookings). Set on Vercel so cron requests are
# authenticated; the route rejects mismatched Authorization when this is set.
CRON_SECRET=

# Payments. Which gateway takes money: razorpay | phonepe | mock.
# Unset = PhonePe if configured, else mock (test bookings, no real charge).
PAYMENT_PROVIDER=
# Razorpay (Dashboard -> Account & Settings -> API Keys). rzp_test_ keys = test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same value as Dashboard -> Webhooks -> Secret for https://<site>/api/razorpay/webhook
# (events: payment.captured, payment.failed, order.paid).
RAZORPAY_WEBHOOK_SECRET=
