# Supabase (public client config — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase service role — SERVER-ONLY. Required for guest booking server actions
# (bypasses RLS). Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email — SERVER-ONLY.
RESEND_API_KEY=
# Verified sender + internal recipient for admin notifications.
EMAIL_FROM="Alpha Adventures <bookings@your-domain>"
ADMIN_NOTIFY_EMAIL=
