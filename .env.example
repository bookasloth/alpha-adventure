# Supabase (public client config — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase service role — SERVER-ONLY. Required for guest booking server actions
# (bypasses RLS). Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email — SERVER-ONLY. Brevo HTTP API is preferred (no SMTP IP
# allowlist; works from serverless). If BREVO_API_KEY is unset, the mailer
# falls back to the SMTP_* creds below.
BREVO_API_KEY=
# Verified sender (must be on a Brevo-authenticated domain) + admin recipient.
EMAIL_FROM="Alpha Adventures <no-reply@your-domain>"
ADMIN_NOTIFY_EMAIL=

# SMTP fallback (used only when BREVO_API_KEY is unset).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# PhonePe payments (SERVER-ONLY). If unset, booking uses the mock payment path.
# Legacy PG sandbox public test creds (no account needed):
#   PHONEPE_MERCHANT_ID=PGTESTPAYUAT
#   PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
#   PHONEPE_SALT_INDEX=1
#   PHONEPE_HOST=https://api-preprod.phonepe.com/apis/pg-sandbox
# Absolute base the gateway redirects back to (no trailing slash).
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_HOST=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_REDIRECT_BASE=http://localhost:3000
